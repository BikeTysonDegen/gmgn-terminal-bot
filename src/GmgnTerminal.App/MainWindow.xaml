<Window x:Class="GmgnTerminal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GmgnTerminal.App.Views"
        Title="gmgn-terminal"
        Width="1240" Height="780" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/gmgn-mark.png"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="16,12,16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ header ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/gmgn-mark.png" Width="26" Height="26" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <TextBlock Text="gmgn-terminal" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock Text="fast trade terminal · copytrade · sniping" Style="{StaticResource DimText}" FontSize="11"
                           VerticalAlignment="Center" Margin="10,1,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- execution mode chip -->
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                 Fill="{StaticResource Warn}"/>
                        <TextBlock Text="PAPER" Style="{StaticResource ChipText}" Foreground="{StaticResource Warn}"/>
                    </StackPanel>
                </Border>

                <!-- engine chip -->
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding EngineStateText}" Style="{StaticResource ChipText}"/>
                    </StackPanel>
                </Border>

                <!-- sol/usd chip -->
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SOL " Style="{StaticResource ChipText}" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding SolUsdText}" Style="{StaticResource ChipText}" FontFamily="Cascadia Mono, Consolas"/>
                    </StackPanel>
                </Border>

                <!-- balance chip -->
                <Border Style="{StaticResource Chip}">
                    <TextBlock Text="{Binding BalanceText}" Style="{StaticResource ChipText}"
                               Foreground="{StaticResource Accent}" FontFamily="Cascadia Mono, Consolas"/>
                </Border>

                <Button Command="{Binding StartStopCommand}" Margin="14,0,0,0" MinWidth="96">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource StartButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Sell}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Sell}"/>
                                    <Setter Property="Foreground" Value="#2A0D10"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{Binding StartStopText}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ tabs ============ -->
        <TabControl Grid.Row="1">
            <TabItem Header="Main">
                <views:MainTab/>
            </TabItem>
            <TabItem Header="Trading">
                <views:TradingTab DataContext="{Binding Settings}"/>
            </TabItem>
            <TabItem Header="Connection">
                <views:ConnectionTab DataContext="{Binding Settings}"/>
            </TabItem>
            <TabItem Header="Wallet">
                <views:WalletTab DataContext="{Binding Settings}"/>
            </TabItem>
            <TabItem Header="Logs">
                <views:LogsTab DataContext="{Binding Logs}"/>
            </TabItem>
        </TabControl>

        <!-- ============ status bar ============ -->
        <Border Grid.Row="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,10,0,0">
            <TextBlock Text="{Binding LastLogText}" Style="{StaticResource DimText}"
                       FontFamily="Cascadia Mono, Consolas" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
