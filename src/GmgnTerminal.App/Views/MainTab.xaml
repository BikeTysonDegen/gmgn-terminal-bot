<UserControl x:Class="GmgnTerminal.App.Views.MainTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ left column: leaders + positions ============ -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- leaders card -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="LEADERS" Style="{StaticResource HeaderText}"/>
                        <TextBlock Text="{Binding Leaders.Count, StringFormat={}{0} wallet(s)}"
                                   Style="{StaticResource DimText}" HorizontalAlignment="Right" FontSize="11"/>
                    </Grid>

                    <DataGrid x:Name="LeadersGrid" ItemsSource="{Binding Leaders}"
                              SelectedItem="{Binding SelectedLeader}"
                              Style="{StaticResource FeedGrid}"
                              IsReadOnly="False" MaxHeight="180"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="34" Header=""/>
                            <DataGridTextColumn Binding="{Binding Display, Mode=OneWay}" Header="WALLET" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                        <Setter Property="ToolTip" Value="{Binding Address}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Alias, UpdateSourceTrigger=LostFocus}" Header="ALIAS" Width="90"/>
                            <DataGridTextColumn Binding="{Binding Multiplier, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Header="MULT" Width="56"/>
                            <DataGridTextColumn Binding="{Binding MinSol, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Header="MIN SOL" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewLeaderAddress, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 ToolTip="solana wallet address to copy"/>
                        <Button Grid.Column="1" Content="ADD" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddLeaderCommand}" Margin="8,0,0,0" Padding="14,6"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewLeaderAlias, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12" ToolTip="optional alias"/>
                        <Button Grid.Column="1" Content="REMOVE" Style="{StaticResource DangerButton}"
                                Command="{Binding RemoveLeaderCommand}" Margin="8,0,0,0" Padding="14,6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- positions card -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="OPEN POSITIONS" Style="{StaticResource HeaderText}" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Positions}" Style="{StaticResource FeedGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Symbol}" Header="TOKEN" Width="76">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Quantity, StringFormat=N0}" Header="QTY" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding ValueSol, StringFormat=F4}" Header="VAL SOL" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding PnlPercent, StringFormat=F1}" Header="PNL %" Width="66">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PnlPercentSign}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Buy}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PnlPercentSign}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource Sell}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="no open positions"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DimText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Positions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ right column: feed + stats ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- feed card -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="ACTIVITY FEED" Style="{StaticResource HeaderText}"/>
                        <Button Content="CLEAR" HorizontalAlignment="Right" Padding="10,3" FontSize="11"
                                Command="{Binding ClearFeedCommand}"/>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Feed}" Style="{StaticResource FeedGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Time}" Header="TIME" Width="66">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Leader}" Header="LEADER" Width="100"/>
                            <DataGridTextColumn Binding="{Binding Side}" Header="SIDE" Width="48">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="11.5"/>
                                        <Setter Property="Foreground" Value="{Binding SideBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Token}" Header="TOKEN" Width="96">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding LeaderSol}" Header="SOL" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Action}" Header="OUR ACTION" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding ActionBrush}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Action}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Pnl}" Header="PNL SOL" Width="76">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                        <Setter Property="Foreground" Value="{Binding PnlBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="no activity yet — press START to begin tracking"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DimText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Feed.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- stats strip -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
                <UniformGrid Rows="1" Columns="7">
                    <StackPanel>
                        <TextBlock Text="BALANCE" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding BalanceText}" Style="{StaticResource StatValue}" Foreground="{StaticResource Accent}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="EQUITY" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding EquityText}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="UNREALIZED" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding UnrealizedText}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="REALIZED" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding RealizedText}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="COPIED B / S" Style="{StaticResource StatLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource StatValue}" Foreground="{StaticResource Buy}"
                                       Text="{Binding Stats.BuysCopied}"/>
                            <TextBlock Style="{StaticResource StatValue}" Foreground="{StaticResource TextSecondary}" Text=" / "/>
                            <TextBlock Style="{StaticResource StatValue}" Foreground="{StaticResource Sell}"
                                       Text="{Binding Stats.SellsCopied}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="SKIPPED / SEEN" Style="{StaticResource StatLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding Stats.Skipped}"/>
                            <TextBlock Style="{StaticResource StatValue}" Foreground="{StaticResource TextSecondary}" Text=" / "/>
                            <TextBlock Style="{StaticResource StatValue}" Foreground="{StaticResource TextSecondary}"
                                       Text="{Binding Stats.LeaderTrades}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="WIN RATE" Style="{StaticResource StatLabel}"/>
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding Stats.WinRatePct, StringFormat=F0}"/>
                    </StackPanel>
                </UniformGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
