<UserControl x:Class="GmgnTerminal.App.Views.LogsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0,10,0,0">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- toolbar -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LEVEL" Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
                        <ComboBox Width="110" Margin="10,0,0,0"
                                  ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}"/>
                        <CheckBox Content="Auto-scroll" Margin="18,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding AutoScroll}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Text="{Binding Lines.Count, StringFormat={}{0} lines}"/>
                        <Button Content="CLEAR VIEW" Padding="12,4" FontSize="11" Command="{Binding ClearCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- log lines -->
                <ListBox x:Name="LinesList" Grid.Row="1" ItemsSource="{Binding Lines}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,1"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Time}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                           Foreground="#5A6577" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Level}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                           Width="44" Margin="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="DEBUG">
                                                    <Setter Property="Foreground" Value="#5A6577"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="INFO">
                                                    <Setter Property="Foreground" Value="{StaticResource Info}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                    <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                    <Setter Property="Foreground" Value="{StaticResource Sell}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Message}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
